{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "dev:backend": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:backend": "node ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=backend-dist/server.cjs",
    "start:backend": "node backend-dist/server.cjs",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test:security": "node ./node_modules/tsx/dist/cli.mjs --test tests/security.test.ts tests/monthly-import.test.ts",
    "verify:source": "node scripts/verify-security-source.mjs",
    "verify:static": "node scripts/verify-static-isolation.mjs",
    "access:provision": "node ./node_modules/tsx/dist/cli.mjs scripts/provision-user-access.ts",
    "access:set-status": "node ./node_modules/tsx/dist/cli.mjs scripts/set-user-status.ts",
    "migration:reconcile": "node ./node_modules/tsx/dist/cli.mjs scripts/reconcile-migration.ts --dry-run",
    "audit:verify-chain": "node ./node_modules/tsx/dist/cli.mjs scripts/verify-audit-chain.ts",
    "release:gate": "node scripts/release-gate.mjs",
    "qa:security": "npm run lint && npm run verify:source && npm run test:security && npm run build && npm run verify:static && npm run build:backend"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^13.5.0",
    "googleapis": "^174.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
