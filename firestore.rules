rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All production application data is server-only through Firebase Admin.
    match /securityAuditEvents/{document=**} { allow read, write: if false; }
    match /securityAuditStreams/{document=**} { allow read, write: if false; }
    match /importHashes/{document=**} { allow read, write: if false; }
    match /importRequests/{document=**} { allow read, write: if false; }
    match /periodLocks/{document=**} { allow read, write: if false; }
    match /users/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
