FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY backend ./backend
COPY shared ./shared
COPY src/types ./src/types
COPY server.ts tsconfig.json ./
RUN npm run build:backend && npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN useradd --create-home --uid 10001 itera
COPY --from=build --chown=itera:itera /app/backend-dist ./backend-dist
COPY --from=build --chown=itera:itera /app/node_modules ./node_modules
COPY --from=build --chown=itera:itera /app/package.json ./package.json
USER itera
EXPOSE 8080
CMD ["node", "backend-dist/server.cjs"]
