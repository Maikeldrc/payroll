# Public frontend configuration. Never place secrets in VITE_* variables.
VITE_BACKEND_URL="http://localhost:8080"
VITE_IDLE_TIMEOUT_MS="900000"
VITE_ABSOLUTE_TIMEOUT_MS="28800000"
VITE_DEMO_MODE="false"

# Backend-only configuration. Store production values in the approved secret/config service.
PORT="8080"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173"
FIREBASE_PROJECT_ID="itera-tools"
APP_ENV="development"
BACKEND_ABSOLUTE_SESSION_SECONDS="28800"
DATA_STORE="sheets"
DATABASE_URL=""
DATABASE_SSL="disable"
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_ALLOWED_IDS=""
MALWARE_SCANNER_URL=""
